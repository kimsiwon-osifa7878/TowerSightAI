APP_ENV=development
LOG_LEVEL=INFO

HAILO_APPS_WORKSPACE=~/hailo-apps
HAILO_APPS_RESOURCES=${HAILO_APPS_WORKSPACE}/resources
HAILO_APPS_PYTHON=${HAILO_APPS_WORKSPACE}/venv_hailo_apps/bin/python
HAILO_ARCH=hailo8
# Backward-compatible setting name. TowerSightAI no longer launches the legacy TAPPAS pipeline.
TAPPAS_WORKSPACE=${HAILO_APPS_WORKSPACE}
# Directory containing libstream_id_tool.so from the installed TAPPAS package.
TAPPAS_POSTPROC_PATH=/usr/lib/x86_64-linux-gnu/hailo/tappas/post_processes
HAILO_MODEL_DIR=${HAILO_APPS_RESOURCES}/models/${HAILO_ARCH}
HAILO_HEF_PATH=${HAILO_MODEL_DIR}/yolov8m.hef
HAILO_POSTPROCESS_SO=${HAILO_APPS_RESOURCES}/so/libyolo_hailortpp_postprocess.so
HAILO_NETWORK_NAME=filter_letterbox
# Current hailo-apps does not bundle the old purpose-specific YOLOv5 HEFs.
# These defaults deliberately use its compatible COCO detector and filter labels in TowerSightAI.
HAILO_VEHICLE_DETECTION_HEF_PATH=${HAILO_HEF_PATH}
HAILO_VEHICLE_DETECTION_POSTPROCESS_SO=${HAILO_POSTPROCESS_SO}
HAILO_PERSON_PRESENCE_HEF_PATH=${HAILO_HEF_PATH}
HAILO_PERSON_PRESENCE_POSTPROCESS_SO=${HAILO_POSTPROCESS_SO}
FAST_ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
FAST_ALPR_OCR_MODEL=cct-xs-v2-global-model

# Tapo cameras allow only two concurrent RTSP sessions per stream. The UI preview and AI
# inference both use stream1, so the evidence recorder MUST use the dedicated stream2 URL
# below whenever RAW_MEDIA_ENABLED=true; leaving RECORD_RTSP_URL empty makes the recorder
# fall back to stream1 and the third session is refused with RTSP 400.
CAMERA_1_ID=ceiling
CAMERA_1_ROLE=ceiling
CAMERA_1_RTSP_URL=rtsp://<username>:<password>@192.168.0.10:554/stream1
CAMERA_1_USERNAME=<username>
CAMERA_1_PASSWORD=<password>
CAMERA_1_ROTATION_DEGREES=270
CAMERA_1_RECORD_RTSP_URL=rtsp://<username>:<password>@192.168.0.10:554/stream2

CAMERA_2_ID=front
CAMERA_2_ROLE=front
CAMERA_2_RTSP_URL=rtsp://<username>:<password>@192.168.0.11:554/stream1
CAMERA_2_USERNAME=<username>
CAMERA_2_PASSWORD=<password>
CAMERA_2_ROTATION_DEGREES=0
CAMERA_2_RECORD_RTSP_URL=rtsp://<username>:<password>@192.168.0.11:554/stream2

CAMERA_3_ID=rear_side
CAMERA_3_ROLE=rear_side
CAMERA_3_RTSP_URL=rtsp://<username>:<password>@192.168.0.12:554/stream1
CAMERA_3_USERNAME=<username>
CAMERA_3_PASSWORD=<password>
CAMERA_3_ROTATION_DEGREES=0
CAMERA_3_RECORD_RTSP_URL=rtsp://<username>:<password>@192.168.0.12:554/stream2

CAMERA_4_ID=opposite_side
CAMERA_4_ROLE=opposite_side
CAMERA_4_RTSP_URL=rtsp://<username>:<password>@192.168.0.13:554/stream1
CAMERA_4_USERNAME=<username>
CAMERA_4_PASSWORD=<password>
CAMERA_4_ROTATION_DEGREES=0
CAMERA_4_RECORD_RTSP_URL=rtsp://<username>:<password>@192.168.0.13:554/stream2

CALIBRATION_PATH=data/calibration/site.json
PLC_ENDPOINT=tcp://127.0.0.1:502
UI_FULLSCREEN=true
UI_CAMERA_RESOLUTION=1280x720
BIRDVIEW_MODE=disabled

# 3D vehicle-box (직육면체) estimation: site geometry and vehicle limits in millimetres.
# Defaults are the 구로 신안타워 approval drawing values (RSTT5-36, 2025-12-08, sheets J001/J002);
# leave a key blank to keep its default. Origin = pallet rectangle centre, x = pallet length.
VEHICLE_BOX_PALLET_LENGTH_MM=5350
VEHICLE_BOX_PALLET_WIDTH_MM=2200
VEHICLE_BOX_RAIL_INNER_WIDTH_MM=2106
VEHICLE_BOX_BAY_HEIGHT_SEDAN_MM=1600
VEHICLE_BOX_BAY_HEIGHT_SUV_MM=1900
VEHICLE_BOX_MAX_LENGTH_MM=5205
VEHICLE_BOX_MAX_WIDTH_MM=2000
VEHICLE_BOX_MAX_WIDTH_WITH_MIRRORS_MM=2100
VEHICLE_BOX_MAX_HEIGHT_SEDAN_MM=1550
VEHICLE_BOX_MAX_HEIGHT_SUV_MM=1850
VEHICLE_BOX_MAX_WHEEL_TRACK_MM=2000
# Which side camera role sees the vehicle front + left side, and which sees rear + right side.
VEHICLE_BOX_FRONT_LEFT_CAMERA=rear_side
VEHICLE_BOX_REAR_RIGHT_CAMERA=opposite_side

# ESP32 serial-to-TCP bridge for raw LD2410 binary frames.
LD2410_TCP_ENABLED=false
LD2410_TCP_BIND_HOST=0.0.0.0
LD2410_TCP_PORT=9000
LD2410_BUFFER_SECONDS=30
LD2410_MAX_SAMPLE_AGE_SECONDS=1
LD2410_CLIENT_IDLE_TIMEOUT_SECONDS=5

# Daily JSONL raw data and Synology SFTP archive. Keep real credentials in .env only.
RAW_DATA_ENABLED=false
RAW_DATA_LOCAL_DIR=artifacts/raw
RAW_DATA_SAMPLE_INTERVAL_SECONDS=0.5
RAW_DATA_PERSON_STALE_SECONDS=1.0
RAW_DATA_PERSON_CLEAR_GRACE_SECONDS=5.0
RAW_DATA_RETENTION_DAYS=14
RAW_DATA_SYNC_INTERVAL_SECONDS=300
RAW_DATA_TIMEZONE=Asia/Seoul
RAW_DATA_SHARD_MINUTES=60
RAW_MEDIA_ENABLED=false
RAW_MEDIA_SNAPSHOT_JPEG_QUALITY=85
RAW_MEDIA_FRAME_MAX_AGE_SECONDS=1
RAW_MEDIA_PRE_SECONDS=5
RAW_MEDIA_VEHICLE_POST_SECONDS=10
RAW_MEDIA_SEGMENT_SECONDS=2
RAW_MEDIA_CLIP_PART_SECONDS=300
RAW_MEDIA_GSTREAMER_PYTHON=/usr/bin/python3
# Hailo가 error 상태로 이어지면 PCIe 재열거를 자동 시도한다(운영자 버튼과 같은 동작).
# 자동 복구는 정비 동작이며 안전 판정·최종 OK와 무관하다. 0회로 두면 버튼으로만 동작한다.
HAILO_AUTO_RECOVERY_ENABLED=true
HAILO_AUTO_RECOVERY_AFTER_SECONDS=120
HAILO_AUTO_RECOVERY_MAX_ATTEMPTS=3
HAILO_AUTO_RECOVERY_WINDOW_SECONDS=3600

# Hailo 장치 이상 시 진단 자료를 NAS <folder>/hailo-incidents/ 로 자동 업로드 (원격 진단용).
# 읽기 전용 수집이며 안전 판정에 영향 없음. RAW_DATA_ENABLED=true 여야 동작한다.
HAILO_INCIDENT_UPLOAD_ENABLED=true
# 같은 고장이 이어질 때 자료를 다시 올리는 최소 간격(초)
HAILO_INCIDENT_MIN_INTERVAL_SECONDS=1800

# 레이더(LD2410) 상시 raw 기록 — 분석 전용, 안전 게이트 영향 없음. 0 = 샘플·감지 창 모두 끔.
RAW_DATA_LD2410_SAMPLE_INTERVAL_SECONDS=1
# 레이더 감지 창: present(fresh+target≠0)가 이 시간 이상 이어지면 radar_window_started
RAW_DATA_RADAR_WINDOW_MIN_SECONDS=3
# absent/unknown이 이 시간 이상 이어지면 radar_window_closed
RAW_DATA_RADAR_WINDOW_CLEAR_SECONDS=5
# 레이더 감지 창 동안 카메라 상태도 함께 기록하는 시간(초, 0=끔) — 카메라 vs 레이더 비교 분석용.
RAW_DATA_RADAR_SAMPLE_SECONDS=60
# 레이더 창 증거(스냅샷+클립). RAW_MEDIA_ENABLED=false면 무의미
RAW_MEDIA_RADAR_EVIDENCE=true
# 레이더 증거 번들 최소 간격(초) — 정적 클러터로 창이 잦아도 대역폭을 지킨다
RAW_MEDIA_RADAR_MIN_INTERVAL_SECONDS=60
# 레이더 창 클립 상한(초) — 창이 몇 시간 이어져도 클립은 여기서 닫힌다
RAW_MEDIA_RADAR_CLIP_MAX_SECONDS=30
SYNOLOGY_NAS_HOST=nas.example.com
SYNOLOGY_NAS_PORT=45222
SYNOLOGY_NAS_ID=<sftp-upload-user>
SYNOLOGY_NAS_PW=<sftp-upload-password>
SYNOLOGY_NAS_FOLDER=/home/<shared-folder>
SYNOLOGY_NAS_KNOWN_HOSTS=~/.ssh/known_hosts
